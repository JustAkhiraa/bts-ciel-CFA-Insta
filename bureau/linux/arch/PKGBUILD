# Le paquet Arch Linux (et Manjaro, EndeavourOS, CachyOS...) de l'application
# BTS CIEL.
#
# Il ne recompile rien : il reprend le programme du paquet .deb fabriqué par
# l'Action « Appli de bureau » sur la même version, et le range comme Arch le
# veut. L'Action pose la version et le .deb à côté de ce fichier, puis lance
# makepkg.
#
# Installer : sudo pacman -U bts-ciel-*.pkg.tar.zst
pkgname=bts-ciel
pkgver=0.1.0
pkgrel=1
pkgdesc="Les fiches de révision du BTS CIEL, en application de bureau"
arch=('x86_64')
url="https://github.com/JustAkhiraa/bts-ciel-CFA-Insta"
license=('custom')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'glib2' 'cairo' 'gdk-pixbuf2' 'hicolor-icon-theme')
options=('!strip' '!debug')
source=("bts-ciel.deb")
sha256sums=('SKIP')

package() {
  # makepkg a déjà ouvert le .deb : son contenu est dans data.tar.*
  bsdtar -xf data.tar.* -C "$pkgdir"
}
